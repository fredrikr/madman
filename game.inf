! Room 21
Object Room "Room"
	with
		description "I'm in a room.",
		!n_to NearChurchDoor,
		before [;
			Go:
				if(direction == w_to && HoleInDoor hasnt absent)
					<<Enter HoleInDoor>>;
		],
		each_turn [;
			if(robbed == 0) {
				robbed = 1;
				faint = 1;
				move Stone to Room2;
				if(Knife in player)
					move Knife to Attic;
				if(Gun in player)
					move Gun to Attic;
				scope_modified = true;
				"I'm hear footsteps behind me..^
					EVERYTHING SPINS AROUND!!^
					I'm somewere else. I've been robbed.^";
			}
		],
		e_to Kitchen,
		w_to RoomDoor,
	has ~light reactive;

DoorClass RoomDoor "d6"
	with
		nouns 'wood' 'wooden' 'door',
		short_name "Closed wood door",
		before [;
			Kick:
				if(HoleInDoor hasnt absent) rfalse;
				give HoleInDoor ~absent;
				MoveFloatingObjects();
				"BANZAI!";
		],
		found_in Room Hall,
		door_dir (w_to) (e_to),
!		door_to Hall,
!		with_key PurpleKey,
	;

Object HoleInDoor "Hole in the door"
	with
		nouns 'hole',
		before [ _dest;
			Enter:
				_dest = Room;
				if(real_location == Room)
					_dest = Hall;
				print "OK^";
				PlayerTo(_dest);
				rtrue;
		],
		found_in Room Hall,
	has static absent;

