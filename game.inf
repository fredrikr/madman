! Object 10
Object -> Flashlight "Electric torch"
	with 
		nouns 'electric' 'torch' 'flashlight' 'lamp',
		after [;
			SwitchOn:
				give self light;
			SwitchOff:
				give self ~light;
		],
	has switchable;

! Room 14
Object Warehouse "Warehouse"
	with
		description "I'm in a warehouse.",
		w_to OutsideWarehouse,
		out_to OutsideWarehouse,
	has ~light scored;

Object -> Steelboxes "Some steelboxes"
	with
		longnouns 'steelboxes' 'steel' 'boxes' 'steelbox' 'box',
		before [;
			Take, Push, Pull, Turn:
				"They're way too heavy.";
			Open:
				"Can't be opened.";
		],
	has proper pluralname;

Object -> Woodbox "One woodbox"
	with
		nouns 'woodbox' 'wood' 'wooden' 'box',
		before [;
			Take, Push, Pull, Turn:
				"It's way too heavy.";
			Open:
				if(Hammer notin player) "I'll need a hammer!";
				remove self;
				move WoodboxPieces to Warehouse;
				move Bottle to Warehouse;
				scope_modified = true;
				"OK^The box fell apart.";
		],
	has proper;

Object WoodboxPieces "Pices of a box"
	with
		parse_name [ _i _w;
			_w = NextWord();
			if(_w == 'piece' or 'pieces' or 'pice' or 'pices') { 
				_i++; 
				_w = NextWord();
				while(_w == 'of' or 'a//') {
					_i++;
					_w = NextWord();
				}
			}
			if(_w == 'wood' or 'wooden' or 'box')
				_i++;
			return _i;
		],
	has proper pluralname reactive;

! Object 18
Object Bottle "Bottle"
	with
		nouns 'bottle',
		description [;
			if(Coke in self)
				"It's some Coke there.";
			"It's empty.";
		],
		before [;
			Receive:
				"That doesn't fit.";
		],
	has general container open transparent;

Object -> Coke "Coke"
	with
		nouns 'coke' 'cocacola' 'coca-cola',
		before [;
			Examine: rfalse;
			Drink:
				faint = 0;
				remove self;
				scope_modified = true;
				"OK";
			default:
				"I can't!!";
		];

