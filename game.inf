Object BigBomb "big bomb"
	with
		time_left 21, ! dx in Basic program
		daemon [ dx;
			dx = self.time_left - 1;
			self.time_left = dx;
			print"^", dx, " turns left to the BIG BANG!^";
			if(dx < 1) {
				deadflag = GS_DEAD;
				"BOOOOOM!!";
			}
		];

[ Initialise x;

! Get rid of warnings
	x = _verb_grammar_end;
#Ifdef DEBUG;
	x = _debug_grammar;
#Endif;
#Ifdef OPTIONAL_SCRIPT;
	x = _script_grammar;
#Endif;

	thedark.description = "TOO DARK TO SEE!!";

	print "^^And once again it's morning...^";
	Telephone.each_turn();
	PlayerTo(Bedroom,1);
	StartDaemon(player);
	
	return 2;
];





