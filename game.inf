! Object 20 (will appear in Attic, when player breaks radio)
Object LittleBomb "Little bomb"
	with 
		nouns 'little' 'bomb',
		description "There is a button on it.",
!		before [;
!			Throw:
!				if(self notin player) rfalse;
!				if(self hasnt general)
!					<<Drop self>>;
!				if(TestScope(Madman)) {
!					give Madman ~animate;
!					StopTimer(self);
!					remove self;
!					move Note to real_location;
!					scope_modified = true;
!					"BOOM!... The madman is now DEAD!!";
!				}
!		],
		time_left 0,
		time_out [;
			if(TestScope(LittleBomb)) {
				print"^BOOOOOM!!^";
				ByeBye(true);
				rtrue;
			}
			remove self;
			print "^I hear a BOOOOM nearby.^";
			if(TestScope(Madman)) {
				print "^The madman turns AROUND!!^
					HE SHOT ME!^";
				ByeBye(true);
			}
			
		],
	has transparent;

Object -> BombButton "Bomb button"
	with
		nouns 'button',
		before [;
			Push:
				if(LittleBomb hasnt general) {
					give LittleBomb general;
					StartTimer(LittleBomb, 2);
				}
				"CLICK!";
		];

! Room 27
Object OnRoof "On roof"
	with
		description "I'm on a roof in the city.",
		s_to [;
			if(Madman hasnt animate) return Elevator;
			PrintMsg(MSG_CANT_DO_THAT_YET);
			rtrue;
		],
		e_to Attic,
		each_turn [;
			if(superparent(Radio) == self) {
				print "^The radio started to sound strange. 
					The madman turns AROUND!!^
					HE SHOT ME!^";
				ByeBye(true);
			}
		],
	has light reactive;

Object -> Madman "The madman"
	with
		nouns 'madman' 'mad' 'man',
		short_name [;
			if(self has animate) rfalse;
			print "Dead madman";
			rtrue;
		],
		before [;
			ThrownAt:
				if(noun == LittleBomb && LittleBomb has general) {
					score = score + 35;
					give Madman ~animate;
					StopTimer(noun);
					remove noun;
					move Note to real_location;
					scope_modified = true;
					"BOOM!... The madman is now DEAD!!";
				}
				remove noun;
				scope_modified = true;
				"I missed!";
			Attack:
				if(self hasnt animate) "He's already dead.";
				"How?";
			Stab:
				if(second ~= 0 or Knife)
					"Stab him with WHAT??";
				if(Knife notin player)
					"I don't have a knife.";
				if(self hasnt animate) "He's already dead.";
				"I can't reach him.";
			Take: 
				if(self hasnt animate)
					"Eww!!";
		],
		get_shot_at [;
			if(self has animate) {
				print "I MISSED!! The madman turns AROUND!!^
					HE SHOT ME!^";
				ByeBye(true);
				rtrue;
			}
		],
	has animate;

