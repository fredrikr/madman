Object Room4 "Room"
	with
		description [;
			if(direction == s_to)
				print "After walking through a short hallway, bending to the east, 
					I come to an open space.^^";
			"I'm in a room.";
		],
		before [;
			Go:
				if(direction == u_to && inhaled_gas == false) {
					print "I'm to heavy. The ladder went off...^    I FALL!!^";
					ByeBye(true);
					rtrue;
				}
		],
		w_to EndOfCorridor,
		u_to RopeLadder,
	has light scored;

