			Say:
				if(GlassDoor hasnt general ||
						first_topic_word ~= 'sesam' or 'sesame') 
					"Nothing happens.";
				give GlassDoor ~locked;
				"ZZZZZzzz  CLICK!";
		],
		e_to Hall,
		w_to GlassDoor,
	has light;

DoorClass -> GlassDoor "d7"
	with
		nouns 'door' 'of' 'glass' 'glass-door',
		short_name [;
			if(self hasnt general) print "Door of glass ";
			else if(self has open) print "Open door";
			else print "Closed door";
			rtrue;
		],
		before [;
			Unlock:
				if(self hasnt general) "It's all just a big plate of glass.";
				"Actually, I can't even find a keyhole.";
		],
		break_it [;
			if(self has general) "That seems pointless.";
			if(second == 0) "Break it with WHAT??";
			if(second ~= Stone) "I'd need a more suitable tool.";
			give self general;
			move PiecesOfGlass to EndOfHall;
			scope_modified = true;
			"CRACK!!";
		],
		door_dir (w_to),
		door_to Attic;

