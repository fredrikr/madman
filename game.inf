!% -~S
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1
!% $LONG_DICT_FLAG_BUG=0
!% $ZCODE_COMPACT_GLOBALS=1
!% $MAX_ABBREVS=96
!% $ZCODE_MAX_INLINE_STRING=1200
!% $TRANSCRIPT_FORMAT=1
!!% $OMIT_SYMBOL_TABLE=1 ! Saves space, only possible without DEBUG mode

Include ">abbreviations.h";

! ####################################
!  Game constants
! ####################################

Constant Story	  "Mad Man";
Constant Headline   "^An interactive race against the clock^^
						Type ABOUT for credits.^^";
Constant NO_PLACES;

Release 0;
Serial "260714";

! Get your own unique IFID for your game at https://www.tads.org/ifidgen/ifidgen
Array UUID_ARRAY string "UUID://F5627028-7964-4D05-A2A6-91BBDC351615//"; 
#Ifdef UUID_ARRAY; #Endif;


Constant OPTIONAL_DARKNESS;
!Constant OPTIONAL_LOOKMODE;
Constant OPTIONAL_PRONOUNS;
Constant OPTIONAL_REACTIVE_PARSE_NAME;
Constant OPTIONAL_SCRIPT;

! Scoring
!Constant NO_SCORE;
Constant MAX_SCORE = 250; ! 165 for rooms, 35 for killing Madman, 50 for stopping bomb
!Constant OPTIONAL_FULL_SCORE;
Constant OPTIONAL_SCORED;
Constant ROOM_SCORE = 11; ! 15 * 11 = 165p
Constant OBJECT_SCORE = 5; ! Not used
!Constant TASKS_PROVIDED; ! See DM4 for what else you need to define for this

Constant STATUSLINE_SCORE; Statusline score;
!Constant STATUSLINE_TIME; Statusline time;

!Constant RUNTIME_ERRORS = 0; ! 0, 1 or 2. 0 = smallest file, 2 = most info

Constant INITIAL_LOCATION_VALUE = Bedroom;

Constant GamePreRoutine = _GamePreRoutine;

! ####################################
!  Library initialization
! ####################################

Replace EndOfGame;

[ EndOfGame;
	return _EndOfGame();
];

Include "nail.h";

Fake_Action TakeAllBut;
Fake_Action DropAllBut;

[ _EndOfGame;
	_UpdateScoreOrTime();
	@new_line;
	if(deadflag == GS_QUIT) @quit;
	print "^  * ";
	if(deadflag == GS_WIN) PrintMsg(MSG_YOU_HAVE_WON);
	else if(deadflag == GS_DEAD) PrintMsg(MSG_YOU_HAVE_DIED);
#Ifdef DeathMessage;
	else if(deadflag >= GS_DEATHMESSAGE) DeathMessage();
#Endif;
	print " *^^";
#Ifndef NO_SCORE;
	<Score>;
#Endif;
	for(::) {
		PrintMsg(MSG_RESTART_RESTORE_OR_QUIT);
		_ReadPlayerInput(true);
		verb_word = parse-->1;
		if(verb_word == 'restart') {
			print"^Press any key to play. Let's go.....";
			_ReadPlayerInput(true, true);
			@restart;
		}
		if(verb_word == 'restore') <Restore>;
#Ifdef Amusing;
		if(AMUSING_PROVIDED == 0 && deadflag == 2 && verb_word == 'amusing') Amusing();
#Endif;
		if(verb_word == 'quit') @quit;
#IfDef OPTIONAL_FULL_SCORE;
		if(verb_word == 'full') <FullScore>;
#EndIf;
	}
];

! ####################################
!  Game globals, properties etc
! ####################################

Property get_shot_at;
Property break_it;
Property read_description;
Property simple_name;

Property maybe_get_shot alias time_left; 
Property bullets alias time_left; 
Property make_sharp alias time_left; 

Global killed = 7; ! w in Basic program
Global faint = 0; ! fa in Basic program
Global help_count = 0;
Global high_temp = 0; ! ht in Basic program
Global w1 = 0; ! Time passed, around bus stop
Global robbed = 0; ! ro in Basic program
Global inhaled_gas; ! o in Basic program

[ Hurrah;
	deadflag = GS_WIN;
	score = score + 50;
	"     **HURRAH!**^^^
		You have completed your mission.
        ^   CONGRATULATIONS!";
];

[ ByeBye p_dead;
	if(p_dead)
		print "^I'M DEAD!!^";
	deadflag = GS_DEAD;
];

Constant PS_NORMAL = 0;
Constant PS_SMALL = 1;
Constant PS_BIG = 2;
Global player_size = PS_NORMAL;

[ MoveTakeable p_from p_to _obj;
	objectloop(_obj)
		if(_obj in p_from && _obj hasnt static or scenery && _obj.&found_in == 0)
			move _obj to p_to;
];

[ BeSmall;
	player_size = PS_SMALL;
	if(Mirror has absent) {
		give LittleHole absent;
		give BigHole ~absent;
	}
	if(player in LittleRoom)
		PlayerTo(BigRoom, true);
	else
		MoveFloatingObjects();
	MoveTakeable(LittleRoom, BigRoom);
	"Oops! It feels very odd inside. I'm now 2 FEET TALL!!";
];

[ BeNormal;
	player_size = PS_NORMAL;
	if(Mirror has absent) {
		give LittleHole ~absent;
		give BigHole absent;
	}
	if(player in BigRoom)
		PlayerTo(LittleRoom, true);
	else
		MoveFloatingObjects();
	MoveTakeable(BigRoom, LittleRoom);
	
	"Oops! It feels very odd inside. I'm now in NORMAL SIZE!!";
];

[ BeBig;
	player_size = PS_BIG;
	"Oops! It feels very odd inside. I'm now 8 FEET TALL!!";
];

! ####################################
!  Dictionary
! ####################################

! Set constant names for dictionary words we want to name explicitly

Include ">generated_dictionary.h";

! ####################################
!  Parser, actions and grammar
! ####################################

Include ">generated_parser.h";

Include ">generated_grammar.inf";


[ _GamePreRoutine;
	if(faint && action ~= ##Inv or ##Quit or ##Help or ##Drink)
		"I'm to faint..";
	rfalse;
];

! ####################################
!  Game objects
! ####################################

Object selfobj "yourself"
	with
		nouns 'me' 'myself' 'yourself',
		get_shot_at [;
			ByeBye(true);
			rtrue;
		],
		daemon [;
			if(Madman has animate && random(40)==17) {
				killed++;
				if(TestScope(Radio))
				print"^Some sounds comes from the RADIO!^";
				if(killed > 19) {
					print "^The madman has now killed 20 persons.^";
					ByeBye();
					rtrue;
				}
			}
		],
	has animate proper transparent;

Class DoorClass
	with
		nouns 'door',
		short_name [; 
			if(self has open) print "Open "; else print "Closed ";
			print "door";
			rtrue;
		],
	has static door openable lockable locked;

! Room 1
Object Bedroom "Bedroom"
	with
		description "I'm in a bedroom.",
		after [;
			Take:
				if(noun == Rug) {
					give BedroomHole ~absent;
					MoveFloatingObjects();
				}
			Drop:
				if(noun == Rug) {
					give BedroomHole absent;
					MoveFloatingObjects();
				}
		],
		d_to [;
			if(BedroomHole in real_location)
				return BedroomHole;
		],
		w_to BedroomDoor,
	has light;

! Object 1
Object -> Money "Some money"
	with nouns 'some' 'money',
	has general proper;

! Object 2
Object -> Radio "Strange radio"
	with 
		nouns 'strange' 'radio',
		description "It's something loose in it.",
		before [;
			Listen:
				"The madman has now killed ", killed, " persons.";
		],
		break_it [;
			if(real_location ~= Attic) "No. I still need it.";
			remove self;
			move LittleBomb to real_location;
			scope_modified = true;
			"OK. Something fell to the floor.^
				The pieces of the radio VANISHES!";
		],
	has;

! Object 3
Object -> Rug "Rug"
	with nouns 'rug',
	has general;

Object -> Telephone "Telephone"
	with 
		nouns 'telephone' 'phone',
		each_turn [;
			if(self has general)
				print "^The telephone is ringing!^";
		],
		before [;
			Answer, Take:
				if(self hasnt general) "It's not ringing.";
				give self ~general;
				"Hello. It's your boss speaking. There is
					a madman loose in town. Your job is to
					stop him before he blow the brain of 20 
					persons.^
					Or he kills you...^
					He has allready killed ",killed," persons.^
					CLICK!!!";
		],
	has static general reactive;

DoorClass -> BedroomDoor "d1"
	with 
		before [;
			Close:
				if(self hasnt open)
					"It's not open.";
				give self ~open;
				"OK";
		],
!		found_in Bedroom Garden,
		door_dir (w_to), ! (e_to),
		door_to Garden
	has ~locked;

Object BedroomHole "Hole"
	with
		nouns 'hole',
		describe [;
			if(real_location == Cellar) return 2;
		],
		found_in Bedroom Cellar,
		door_dir (d_to) (u_to),
	has static door open absent;

! Room 2
Object Cellar "Cellar"
	with
		description "I'm in a cellar.",
		after [;
			Look:
				print "I can also go UP.^";
				rfalse;
		],
		u_to BedroomHole,
		e_to CellarDoor,
	has light scored;

! Object 4
Object -> Jacket "Bullet proof jacket"
	with 
		nouns 'bullet' 'proof' 'jacket',
		invent [;
			if(self in player && self has worn) {
				print "I'm wearing a bullet proof jacket";
				rtrue;
			}
		],
		before [;
			Drop:
				if(self in player && self has worn) {
					give self ~worn;
					remove self;
					scope_modified = true;
					"OK. The jacket.... VANISHES....!^
					It feels better now.";
				}
		],
	has clothing;

DoorClass -> CellarDoor "d2"
	with
		door_dir (e_to),
		door_to Sauna,
		with_key PurpleKey;

! Room 3
Object Garden "Garden"
	with
		description "I'm in a garden.",
		e_to Bedroom,
		maybe_get_shot [;
			if(Jacket notin player || Jacket hasnt worn) {
				print "^Someone shot me!!^";
				ByeBye(true);
				rtrue;
			}
		],
		before [;
			Going:
				return self.maybe_get_shot();
		],
		each_turn [;
			self.maybe_get_shot();
		],
	has light scored reactive;

Object -> GardenStone "Stone"
	with nouns 'stone',
	before [;
		Take:
			"It's to heavy to LIFT.";
		Push, Pull:
			if(self hasnt general) {
				give self general;
				move PurpleKey to real_location;
				scope_modified = true;
			}
			"OK";
	];

! Object 16
Object PurpleKey "Purple key"
	with nouns 'purple' 'key',
	has general;

! Room 4
Object Sauna "Sauna"
	with
		description "I'm in a sauna.",
		before [;
			Going:
				if(BedroomDoor has open) {
					print"AAAAH!! Someone came behind me and cutted my throat!
							My last thought was 'OH..I forgotten to close 
							th...^";
					ByeBye(true);
				}
		],
		each_turn [;
			if(Jacket in player && Jacket has worn) {
				high_temp++;
				print "^It's very hot here!^";
				if(high_temp > 3) {
					print"I got overheathed and collapsed.^";
					ByeBye(true);
				}
			}
		],
		s_to SaunaDoor,
		e_to Bathroom,
		w_to Cellar,
	has light scored reactive;

! Object 5
Object -> Gun "Gun"
	with
		description [;
			if(self.bullets == 0)
				"It's empty.";
			"It's loaded.^", self.bullets, " bullets left.";
		],
		nouns 'gun',
		bullets 0
	has;

! Object 7
Object -> Letter "Letter"
	with 
		nouns 'letter',
		description "It's something written there.",
		read_description "In many cases RED is GOOD in others...",
	has general;

DoorClass -> SaunaDoor "d3"
	with 
		description [;
			if(Padlock in self)
				"It's locked with a big padlock.";
			PrintMsg(MSG_EXAMINE_NOTHING_SPECIAL, self);
		],
		door_dir (s_to),
		door_to [;
			if(player_size == PS_SMALL)
				return BigRoom;
			return LittleRoom;
		],
!		with_key PurpleKey,
	has transparent;

Object -> -> Padlock "Padlock"
	with
		nouns 'padlock' 'pad' 'lock',
		break_it [;
			"That's a very sturdy padlock.";
		],
		get_shot_at [;
			give SaunaDoor ~locked;
			remove self;
			scope_modified = true;
			print "The padlock went in thousand pieces and VANISHED!^";
			rtrue;
		];

! Room 5
Object Bathroom "Bathroom"
	with
		description "I'm in a bathroom.",
		w_to Sauna,
	has light;

! Object 6
Object -> Ammunition "Ammunition"
	with 
		nouns 'ammunition' 'ammo' 'bullets' 'rounds',
		bullets 6,
	has general;

Object -> BathroomNote "Note nailed to the wall."
	with
		nouns 'note' 'nailed',
		description "It's something written there.",
		read_description "In this case HELP might help.",
		before [;
			Take, Pull, Push, Turn: "Better leave it be.";
		],
	has static;

! Room 6
Object LittleRoom "Little room"
	with
		description "I'm in a little room.",
		n_to Sauna,
	has light scored;

! Object 8
Object -> RedPill "Pill. Colour: RED"
	with
		nouns 'pill' 'colour' 'color' 'red',
		before [;
			Eat:
				print "OK^";
				remove self;
				scope_modified = true;
				if(player_size == PS_NORMAL)
					BeSmall();
				else ! Player is big
					BeNormal();
				rtrue;
		],
	has general;

! Object 9
Object -> BluePill "Pill. Colour: BLUE"
	with
		nouns 'pill' 'colour' 'color' 'blue',
		before [;
			Eat:
				print "OK^";
				remove self;
				scope_modified = true;
				if(player_size == PS_NORMAL)
					BeBig();
				else ! Player is small
					BeNormal();
				rtrue;
		],
	has general;

Object Mirror "Mirror"
	with
		nouns 'mirror',
		description "Today I seem to be angry.",
		break_it [;
			give self absent;
			give PiecesOfMirror ~absent;
			if(real_location == BigRoom) give BigHole ~absent;
			else give LittleHole ~absent;
			scope_modified = true;
			MoveFloatingObjects();
			if(itobj == self)
				PronounNotice(PiecesOfMirror);
			"CRACK!!";
		],
		found_in LittleRoom BigRoom,
	has static;

Object PiecesOfMirror "Pieces of a mirror"
	with
		parse_name [ _i _w;
			_w = NextWord();
			if(_w == 'piece' or 'pieces') { 
				_i++; 
				_w = NextWord();
				while(_w == 'of' or 'a//') {
					_i++;
					_w = NextWord();
				}
			}
			if(_w == 'mirror')
				_i++;
			return _i;
		],
		found_in LittleRoom BigRoom,
	has static absent pluralname reactive;

Object LittleHole "Little hole"
	with
		nouns 'little' 'hole',
		before [ ;
			Enter:
				"I'm to BIG!";
		],
		found_in LittleRoom Streets,
	has static absent;

! Room 7
Object BigRoom "Big room"
	with
		description "I'm in a big room.",
		n_to Sauna,
	has light;

Object BigHole "Big hole"
	with
		nouns 'big' 'hole',
		before [ _dest;
			Enter:
				_dest = BigRoom;
				if(real_location == BigRoom)
					_dest = Streets;
				print "OK^";
				PlayerTo(_dest);
				rtrue;
		],
		found_in BigRoom Streets,
	has static absent;

! Room 8
Object Streets "Streets"
	with
		description "I'm in a maze of streets.",
		n_to Streets,
		s_to Streets,
		e_to Streets,
		w_to Streets,
		d_to SubwayStation,
	has light scored;

Object -> TallBuildings "Tall buildings"
	with
		nouns 'tall' 'building' 'buildings',
		before [;
			Examine: rfalse;
			default:
				PrintMsg(MSG_ABSURD);
				rtrue;
		],
	has static pluralname;

Object -> People "Lots of people"
	with
		parse_name [ _i _w;
			_w = NextWord();
			if(_w == 'lots') { 
				_i++; 
				_w = NextWord();
				if(_w == 'of') {
					_i++;
					_w = NextWord();
				}
			}
			if(_w == 'people')
				_i++;
			return _i;
		],
		get_shot_at [;
			print "The cops came and got me!^";
			ByeBye();
			rtrue;
		],
		before [;
			Attack:
				"NO! I'm a police. Not a bandit.";
			Examine, Shoot: rfalse;
			default:
				PrintMsg(MSG_ABSURD);
				rtrue;
		],
	has static proper pluralname reactive;

Object -> StairInStreet "Stair Leading Down"
	with
		nouns 'stair' 'stairs',
		before [ ;
			Enter:
				print "OK^";
				PlayerTo(SubwayStation);
				rtrue;
		],
	has static;

! Room 9
Object SubwayStation "Subway station"
	with
		description "I'm in a subway station.",
		w_to Streets,
	has light;

! Object 17
Object -> Ticket "Ticket"
	with nouns 'ticket',
	before [;
		Buy:
			if(self has concealed) {
				if(Money in player) {
					remove Money;
					move self to player;
					give self ~concealed;
					update_moved = true;
					"OK";
				} else
					"I don't have any money.";
			} else
				"I have already bought it.";
		default:
			if(self has concealed)
				"I don't have a ticket.";
	],
	has general concealed;

Object -> SubwayStationSign "Sign"
	with
		nouns 'sign',
		description "It's something written there.",
		read_description "PRICES:  One ticket 1 $.",
	has static;

Object -> Train "Train"
	with
		nouns 'train',
		before [ _dest;
			Take, Push, Pull, Turn:
				PrintMsg(MSG_ABSURD);
				rtrue;
			Enter:
				if(Ticket notin player) {
					PrintMsg(MSG_CANT_DO_THAT_YET);
					rtrue;
				}	
				if(player_size == PS_SMALL)
					"Children are not allowed to travel alone.";
				print "OK^The train stops after a while. I wen't off.^";
				_dest = SubwayStation2;
				if(real_location == SubwayStation2)
					_dest = SubwayStation;
				PlayerTo(_dest);
				rtrue;
		],
		found_in SubwayStation SubwayStation2,
	has static;

! Room 10
Object SubwayStation2 "Subway station"
	with
		description "I'm in a subway station.",
		u_to StairInSubwayAndHarbour,
	has light scored;

Object -> StairInSubwayAndHarbour "Stair"
	with
		nouns 'stair' 'stairs',
		before [;
			Enter:
				print "OK^";
		],
		short_name [;
			print "Stair leading ";
			if(real_location == SubwayStation2) print "up";
			else print "down";
			rtrue;
		],
		found_in SubwayStation2 Harbour,
		door_dir (u_to) (d_to),
	has static door open;

