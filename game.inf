Object -> WarehouseDummy "Warehouse"
	with
		nouns 'warehouse' 'ware' 'house',
		before [;
			Climb:
				print "OK^";
				PlayerTo(RoofOfWarehouse);
				rtrue;
			Open:
				"The warehouse door stands slightly ajar.";
			Close:
				"I don't want to close it.";
			Enter:
				<<Go FAKE_IN_OBJ>>;
!				print "OK^";
!				PlayerTo(Warehouse);
