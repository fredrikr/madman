				rtrue;
			}
		],
		before [;
			Drop:
				if(self in player && self has worn)
					"I can't.";
		],
	has clothing;

! Room 34
Object RedRoom "Red room"
	with
		description "I'm in a big red room.",
		before [;
			Sit:
				if(noun == 0 || noun == Chair) {
					if(DivingSuit notin player || DivingSuit hasnt worn) {
						print "AAAH! HIGH VOLTAGE in the chair.^";
						ByeBye(true);
						rtrue;
					}
					print "OK^";
					PlayerTo(InChair);
					rtrue;
				}
		],
		after [;
			Look:
				print "I can also go DOWN.^";
				rfalse;
		],
		d_to Room4,
	has light scored;

