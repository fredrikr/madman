		door_dir u_to,
	has static door open;

Object -> Wardrobe "Wardrobe"
	with
		nouns 'wardrobe',
		short_name [; 
			if(self has open) print "Open "; else print "Closed ";
			print "wardrobe";
			rtrue;
		],
		description [;
			print "The wardrobe contains:^";
			TallPrintContents(self);
		],
		before [;
			Enter:
				if(self has open)
					"I'm to big.";
		],
	has static container openable;

Object -> -> GasTube "Helium gas tube"
	with
		nouns 'helium' 'gas' 'tube' 'button',
		description "I can see a button.",
		before [ ;
			Take:
				if(WordAddress(num_words)->0 ~= 'g') rfalse; ! Player didn't use the word "gas"
				if(self has general) 
					"Can't hold gas in my hand.";
			Push:
				if(WordAddress(num_words)->0 ~= 'b') rfalse; ! Player didn't use the word "button"
				give self general;
				StartTimer(self, 3); ! Gas in room is available for this move + 2 more
				"Some gas came out.";
			Inhale:
				if(self has general) {
					inhaled_gas = true;
					"AAAH! I'm feeling much more light now.";
				}
		],
		time_left 0,
		time_out [;
			give self ~general;
		],
	has static;

